{
  "name": "demoblaze-playwright-tests",
  "version": "1.0.0",
  "description": "Functional UI automation for DemoBlaze using Playwright and TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "install:browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "typescript": "^5.3.0"
  },
  "playwright": {
    "testDir": "tests",
    "timeout": 30000,
    "use": {
      "baseURL": "https://www.demoblaze.com",
      "headless": true,
      "viewport": { "width": 1280, "height": 720 },
      "actionTimeout": 10000,
      "screenshot": "only-on-failure",
      "trace": "on-first-retry"
    }
  }
}